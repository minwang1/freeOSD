<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MonitorControl.App.ViewModels"
        xmlns:core="using:MonitorControl.Core.Models"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="MonitorControl.App.MainWindow"
        x:DataType="vm:ControlViewModel"
        Title="Monitor Control"
        Width="1100" Height="720" MinWidth="900" MinHeight="600">
    <Grid RowDefinitions="Auto,*,Auto" Background="#F4F6FA">
        <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Text="Monitor Control" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" MinWidth="240"
                          ItemsSource="{Binding Monitors}"
                          SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                          IsEnabled="{Binding HasMonitors}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="core:MonitorDescriptor">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Foreground="#687386" />
                <Button Grid.Column="3" Content="⟳ 重新扫描" Command="{Binding RescanCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="210,*">
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel Spacing="6">
                    <Button Content="◉  控制" HorizontalContentAlignment="Left" Classes="nav-selected"
                            Click="OnControlTabClick" />
                    <Button Content="▣  预设与自动化" HorizontalContentAlignment="Left"
                            Click="OnProfilesTabClick" />
                    <Button Content="◈  识别与诊断" HorizontalContentAlignment="Left" IsEnabled="False" />
                    <Button Content="⚙  设置" HorizontalContentAlignment="Left" Click="OnSettingsTabClick" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Padding="28" IsVisible="{Binding IsControlTab}">
                <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="控制" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="调节显示器画面、色彩与输入源。只显示当前设备声明支持的控制。" Foreground="#687386" />
                    </StackPanel>

                    <Border IsVisible="{Binding IsLoading}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="正在读取显示器…" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="设备扫描和 DDC/CI 读取在后台执行，界面仍可响应。" Foreground="#687386" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasScanError}" Background="White" BorderBrush="#F2C7C4" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="10">
                            <TextBlock Text="无法扫描显示器" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="#B42318" />
                            <Button Content="重试扫描" Command="{Binding RescanCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasNoMonitors}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="10">
                            <TextBlock Text="尚未发现可访问的显示器" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="请确认显示器、显卡和连接链路支持 DDC/CI，并在显示器菜单中启用该功能。" TextWrapping="Wrap" Foreground="#687386" />
                            <Button Content="重新扫描" Command="{Binding RescanCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasMonitors}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="16">
                            <TextBlock Text="画面与色彩" FontSize="18" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding ContinuousControls}">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VcpControlViewModel">
                                        <Grid ColumnDefinitions="150,*,64" RowDefinitions="Auto,Auto" Margin="0,5">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                    Value="{Binding Value, Mode=TwoWay}"
                                                    IsEnabled="{Binding IsReadable}"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding ErrorText}" Foreground="#B42318" FontSize="12"
                                                       IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="当前显示器未声明可调节的亮度、对比度或 RGB 增益控件。"
                                       Foreground="#687386" IsVisible="{Binding HasNoContinuousControls}" />

                            <ItemsControl ItemsSource="{Binding DiscreteControls}">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VcpControlViewModel">
                                        <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto" Margin="0,5">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsReadable}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:VcpValueOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="应用" Command="{Binding ApplyCommand}" Margin="10,0,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                       Text="{Binding ErrorText}" Foreground="#B42318" FontSize="12"
                                                       IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="切换输入源可能导致画面暂时中断。点击“应用”后会再次确认。"
                                       Foreground="#687386" FontSize="12" IsVisible="{Binding HasInputSource}" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasHdrSection}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="HDR" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding HdrStatus}" Foreground="#687386" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsHdrEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding IsHdrSupported}" Command="{Binding ToggleHdrCommand}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding HasRefreshRateSection}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="12">
                            <TextBlock Text="分辨率" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="12">
                                <TextBlock Text="目标分辨率" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ResolutionModes}"
                                          SelectedItem="{Binding SelectedResolutionMode, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSetResolution}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:DisplayMode">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Width}" />
                                                <TextBlock Text="×" />
                                                <TextBlock Text="{Binding Height}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="应用分辨率（15 秒试用）"
                                        Command="{Binding ApplyResolutionCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ResolutionStatusText}" Foreground="#687386" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResolutionError}" Foreground="#B42318" FontSize="12"
                                       IsVisible="{Binding HasResolutionError}" TextWrapping="Wrap" />
                            <TextBlock Text="系统没有报告可用分辨率。" Foreground="#687386"
                                       IsVisible="{Binding HasNoResolutionModes}" />

                            <Separator Margin="0,4" />
                            <TextBlock Text="刷新率" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="150,*,Auto" ColumnSpacing="12">
                                <TextBlock Text="目标刷新率" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshRateModes}"
                                          SelectedItem="{Binding SelectedRefreshRateMode, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSetRefreshRate}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:DisplayMode">
                                            <TextBlock Text="{Binding RefreshRateHz, StringFormat='{}{0} Hz'}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="应用刷新率（15 秒试用）"
                                        Command="{Binding ApplyRefreshRateCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding RefreshRateStatusText}" Foreground="#687386" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RefreshRateError}" Foreground="#B42318" FontSize="12"
                                       IsVisible="{Binding HasRefreshRateError}" TextWrapping="Wrap" />
                            <TextBlock Text="所选分辨率没有可用刷新率选项。" Foreground="#687386"
                                       IsVisible="{Binding HasNoRefreshRateModes}" />
                            <Button Content="重试恢复上一次设置" Command="{Binding RetryRefreshRateRestoreCommand}"
                                    IsVisible="{Binding HasRefreshRateRestoreFailure}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1" Padding="28" IsVisible="{Binding IsProfilesTab}">
                <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Spacing="4">
                        <TextBlock Text="预设与自动化" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="保存显示器预设，并可按前台应用自动应用。" Foreground="#687386" />
                    </StackPanel>
                    <Border IsVisible="{Binding HasMonitors}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="12">
                            <TextBlock Text="显示器预设" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="保存当前已确认的显示器控件值。应用时会逐项写入并验证。" Foreground="#687386" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox PlaceholderText="预设名称" Text="{Binding ProfileName, Mode=TwoWay}" />
                                <Button Grid.Column="1" Content="保存当前设置" Command="{Binding SaveProfileCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:MonitorProfile"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="应用预设" Command="{Binding ApplyProfileCommand}" />
                                <Button Grid.Column="2" Content="删除" Command="{Binding DeleteProfileCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ProfileStatus}" Foreground="#687386" TextWrapping="Wrap" />
                            <Separator Margin="0,4" />
                            <TextBlock Text="应用切换" FontSize="18" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <CheckBox Content="为前台应用切换预设"
                                          IsChecked="{Binding IsAutomationEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding IsAutomationSupported}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AutomationRules}"
                                          SelectedItem="{Binding SelectedAutomationRule, Mode=TwoWay}"
                                          PlaceholderText="暂无应用规则">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:ApplicationProfileRule">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding ExecutablePath}" />
                                                <TextBlock Text="→" />
                                                <TextBlock Text="{Binding ProfileName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="添加规则…" Command="{Binding AddAutomationRuleCommand}" />
                                <Button Grid.Column="3" Content="删除规则" Command="{Binding RemoveAutomationRuleCommand}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <TextBlock Text="无匹配规则时使用：" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}"
                                          SelectedItem="{Binding DefaultAutomationProfile, Mode=TwoWay}"
                                          PlaceholderText="不应用预设">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:MonitorProfile"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="添加规则时可搜索已安装程序，或使用上一个前台程序。程序规则优先匹配；未命中时应用默认预设。删除预设会同步移除关联规则，自动应用会跳过输入源设置。"
                                       Foreground="#687386" TextWrapping="Wrap" />
                            <TextBlock Text="还没有已保存的预设。请先在上方保存预设，再创建应用规则。"
                                       Foreground="#687386" IsVisible="{Binding HasNoProfiles}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding AutomationStatus}" Foreground="#687386" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border IsVisible="{Binding HasNoMonitors}" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="8">
                            <TextBlock Text="连接显示器后即可创建和应用预设。" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="请先扫描并选择可访问的显示器。" Foreground="#687386" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1" Padding="28" IsVisible="{Binding IsSettingsTab}">
                <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />
                    <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="10">
                            <TextBlock Text="启动与托盘" FontSize="18" FontWeight="SemiBold" />
                            <CheckBox Content="登录 Windows 时启动 Monitor Control"
                                      IsChecked="{Binding LoginStartupEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding IsLoginStartupSupported}" />
                            <TextBlock Text="{Binding LoginStartupStatus}" Foreground="#687386" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" Padding="16,9" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#687386" />
        </Border>
    </Grid>
</Window>
