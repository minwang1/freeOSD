<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>freeOSD</AssemblyName>
    <Product>freeOSD</Product>
    <ApplicationTitle>freeOSD</ApplicationTitle>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\freeosd-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\freeosd-logo.ico" Link="Assets\freeosd-logo.ico" />
    <AvaloniaResource Include="..\..\assets\freeosd-logo-512.png" Link="Assets\freeosd-logo-512.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="TKCode.Arc" Version="0.3.2-preview.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorControl.Core\MonitorControl.Core.csproj" />
    <ProjectReference Include="..\MonitorControl.Platform.Windows\MonitorControl.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
